const exerciseName = "{{exerciseName}}";
const logsFolder = "{{workoutFolder}}/Logs";
const allPages = dv.pages('"' + logsFolder + '"');

const plugin = app.plugins.plugins['workout-tracker'];
const chartMin = plugin?.settings?.chartRepsMin ?? 0;
const chartMax = plugin?.settings?.chartRepsMax ?? 15;

if (allPages.length === 0) {
	dv.paragraph("Данные по подходам пока не найдены.");
} else {
	const rows = [];
	const maxReps = new Map();
	const maxRepsWeight = new Map();
	const pageLinks = new Map();
	
	const exerciseHeader = "### " + exerciseName;
	const setRegex = /^Подход\s*(\d+):\s*(.+)$/i;
	const weightRegex = /(\d+[\,\.]?\d*)\s*кг/i;
	const repsRegex = /(\d+)\s*раз/i;
	const circleRegex = /^##\s*Круг\s*(\d+)/i;

	for (const page of allPages) {
		const content = await dv.io.load(page.file.path);
		const lines = content.split("\n");
		const date = page.file.name.slice(0, 10);
		const dateParts = date.split('-');
		const displayDate = dateParts[2] + "." + dateParts[1] + "." + dateParts[0];
		const logLink = "[[" + page.file.path + "|" + displayDate + "]]";
		pageLinks.set(date, logLink);
		
		let i = 0;
		let currentCircle = 0;
		
		while (i < lines.length) {
			const line = lines[i].trim();
			const circleMatch = circleRegex.exec(line);
			if (circleMatch) {
				currentCircle = parseInt(circleMatch[1]);
				i++;
				continue;
			}
			
			if (line === exerciseHeader) {
				i++;
				let setNumber = 0;
				let dayMaxReps = 0;
				let dayMaxRepsWeight = 0;
				
				while (i < lines.length) {
					const currentLine = lines[i].trim();
					if (currentLine.startsWith("###") || currentLine.startsWith("##")) break;
					
					// Игнорируем строки со статистикой (но НЕ строки с "Подход")
					if (!currentLine.startsWith("Подход") && (
						currentLine.includes("Максималка") || 
						currentLine.includes("Последний актуальный подход") || 
						currentLine.includes("Максимальный вес"))) {
						i++;
						continue;
					}
					
					if (currentLine.length > 0) {
						const setMatch = setRegex.exec(currentLine);
						if (setMatch) {
							setNumber = parseInt(setMatch[1]);
							const details = setMatch[2];
							const weightMatch = weightRegex.exec(details);
							const repsMatch = repsRegex.exec(details);
							const weight = weightMatch ? weightMatch[1].replace(",", ".") : "—";
							const reps = repsMatch ? repsMatch[1] : "—";
							const displaySet = currentCircle > 0 ? currentCircle : setNumber;
							rows.push([logLink, displaySet, weight, reps, details]);
							if (repsMatch) {
								const repsCount = Number(repsMatch[1]);
								if (repsCount > dayMaxReps) {
									dayMaxReps = repsCount;
									dayMaxRepsWeight = weightMatch ? Number(weightMatch[1].replace(",", ".")) : 0;
								}
							}
						} else if (currentLine.includes("раз") || currentLine.includes("кг")) {
							setNumber++;
							const weightMatch = weightRegex.exec(currentLine);
							const repsMatch = repsRegex.exec(currentLine);
							const weight = weightMatch ? weightMatch[1].replace(",", ".") : "—";
							const reps = repsMatch ? repsMatch[1] : "—";
							const displaySet = currentCircle > 0 ? currentCircle : setNumber;
							rows.push([logLink, displaySet, weight, reps, currentLine]);
							if (repsMatch) {
								const repsCount = Number(repsMatch[1]);
								if (repsCount > dayMaxReps) {
									dayMaxReps = repsCount;
									dayMaxRepsWeight = weightMatch ? Number(weightMatch[1].replace(",", ".")) : 0;
								}
							}
						}
					}
					i++;
				}
				
				if (dayMaxReps > 0) {
					maxReps.set(date, dayMaxReps);
					maxRepsWeight.set(date, dayMaxRepsWeight);
				}
				currentCircle = 0;
			} else {
				i++;
			}
		}
	}

	if (rows.length === 0) {
		dv.paragraph("Данные по подходам пока не найдены.");
	} else {
		rows.sort((a, b) => a[0] === b[0] ? Number(a[1]) - Number(b[1]) : (a[0] > b[0] ? -1 : 1));

		const maxRepsRows = Array.from(maxReps.entries())
			.sort((a, b) => (a[0] > b[0] ? -1 : 1))
			.map(([date, reps]) => [pageLinks.get(date) || date, reps, maxRepsWeight.get(date) || "—"]);

		if (rows.length > 0) {
			dv.header(3, "🎯 График зависимости повторений от веса");
			
			const allSetsData = [];
			for (const row of rows) {
				const weight = row[2];
				const reps = row[3];
				if (weight !== "—" && reps !== "—") {
					const weightNum = Number(weight);
					const repsNum = Number(reps);
					if (weightNum >= 0 && repsNum > 0) {
						allSetsData.push([weightNum, repsNum]);
					}
				}
			}
			
			if (allSetsData.length > 0) {
				allSetsData.sort((a, b) => a[0] - b[0]);
				
				const labels = allSetsData.map(([weight]) => weight + " кг");
				const values = allSetsData.map(([, reps]) => reps);
				const mermaidChart = "```mermaid\n%%{init: {'theme':'base', 'themeVariables': { 'xyChart': {'plotColorPalette': '#FF6B00'}}}}%%\nxychart-beta\n    title \"Повторения в зависимости от веса (все подходы)\"\n    x-axis [" + labels.map(l => '"' + l + '"').join(', ') + "]\n    y-axis \"Повторения\" " + chartMin + " --> " + chartMax + "\n    line [" + values.join(', ') + "]\n```";
				dv.paragraph(mermaidChart);
				dv.paragraph("");
			}
		}

		if (maxRepsRows.length > 0) {
			dv.paragraph("");
			dv.header(3, "🏆 Максимальные повторения по дням");
			dv.table(["Дата", "Повторения", "Вес (кг)"], maxRepsRows);
		}

		dv.paragraph("");
		dv.header(3, "📊 Детальная статистика");
		dv.table(["Дата", "Подход", "Вес (кг)", "Повторения", "Описание"], rows);
	}
}
