const exerciseName = "{{exerciseName}}";
const logsFolder = "{{workoutFolder}}/Logs";
const allPages = dv.pages('"' + logsFolder + '"');

if (allPages.length === 0) {
	dv.paragraph("Данные по подходам пока не найдены.");
} else {
	const rows = [];
	const summary = new Map();
	const maxReps = new Map();
	const pageLinks = new Map();
	
	const exerciseHeader = "### " + exerciseName;
	const setRegex = /^Подход\s*(\d+):\s*(.+)$/i;
	const repsRegex = /(\d+)\s*раз/i;
	const circleRegex = /^##\s*Круг\s*(\d+)/i;

	for (const page of allPages) {
		const content = await dv.io.load(page.file.path);
		const lines = content.split("\n");
		const date = page.file.name.slice(0, 10);
		const dateParts = date.split('-');
		const displayDate = dateParts[2] + "." + dateParts[1] + "." + dateParts[0];
		const logLink = "[[" + page.file.path + "|" + displayDate + "]]";
		pageLinks.set(date, logLink);
		
		let i = 0;
		let currentCircle = 0;
		
		while (i < lines.length) {
			const line = lines[i].trim();
			const circleMatch = circleRegex.exec(line);
			if (circleMatch) {
				currentCircle = parseInt(circleMatch[1]);
				i++;
				continue;
			}
			
			if (line === exerciseHeader) {
				i++;
				let setNumber = 0;
				let dayMaxReps = 0;
				
				while (i < lines.length) {
					const currentLine = lines[i].trim();
					if (currentLine.startsWith("###") || currentLine.startsWith("##")) break;
					
					// Игнорируем строки со статистикой (но НЕ строки с "Подход")
					if (!currentLine.startsWith("Подход") && (
						currentLine.includes("Максималка") || 
						currentLine.includes("Последний актуальный подход") || 
						currentLine.includes("Максимальный вес"))) {
						i++;
						continue;
					}
					
					if (currentLine.length > 0) {
						const setMatch = setRegex.exec(currentLine);
						if (setMatch) {
							setNumber = parseInt(setMatch[1]);
							const details = setMatch[2];
							const repsMatch = repsRegex.exec(details);
							const reps = repsMatch ? repsMatch[1] : "—";
							const displaySet = currentCircle > 0 ? currentCircle : setNumber;
							rows.push([logLink, displaySet, reps, details]);
							if (repsMatch) {
								const repsNum = Number(repsMatch[1]);
								summary.set(date, (summary.get(date) || 0) + repsNum);
								dayMaxReps = Math.max(dayMaxReps, repsNum);
							}
						} else if (currentLine.includes("раз")) {
							setNumber++;
							const repsMatch = repsRegex.exec(currentLine);
							const reps = repsMatch ? repsMatch[1] : "—";
							const displaySet = currentCircle > 0 ? currentCircle : setNumber;
							rows.push([logLink, displaySet, reps, currentLine]);
							if (repsMatch) {
								const repsNum = Number(repsMatch[1]);
								summary.set(date, (summary.get(date) || 0) + repsNum);
								dayMaxReps = Math.max(dayMaxReps, repsNum);
							}
						}
					}
					i++;
				}
				
			if (dayMaxReps > 0) {
				maxReps.set(date, dayMaxReps);
			}
			currentCircle = 0;
		} else {
			i++;
		}
	}
}	if (rows.length === 0) {
		dv.paragraph("Данные по подходам пока не найдены.");
	} else {
		rows.sort((a, b) => a[0] === b[0] ? Number(a[1]) - Number(b[1]) : (a[0] > b[0] ? -1 : 1));

		const summaryRows = Array.from(summary.entries())
			.sort((a, b) => (a[0] > b[0] ? -1 : 1))
			.map(([date, reps]) => [pageLinks.get(date) || date, reps]);
		
		const maxRepsRows = Array.from(maxReps.entries())
			.sort((a, b) => (a[0] > b[0] ? -1 : 1))
			.map(([date, reps]) => [pageLinks.get(date) || date, reps]);

		if (summaryRows.length > 0) {
			dv.header(3, "📈 График суммарных повторений");
			const chartData = Array.from(summary.entries()).sort((a, b) => (a[0] < b[0] ? -1 : 1));
			const labels = chartData.map(([date]) => {
				const parts = date.split('-');
				return parts[2] + "." + parts[1];
			});
			const values = chartData.map(([, reps]) => reps);
			const mermaidChart = "```mermaid\n%%{init: {'theme':'base', 'themeVariables': { 'xyChart': {'plotColorPalette': '#FF6B00'}}}}%%\nxychart-beta\n    title \"Суммарные повторения за день\"\n    x-axis [" + labels.map(l => '"' + l + '"').join(', ') + "]\n    y-axis \"Повторения\" 0 --> " + (Math.max(...values) + 10) + "\n    line [" + values.join(', ') + "]\n```";
			dv.paragraph(mermaidChart);
			dv.paragraph("");
		}

		if (maxRepsRows.length > 0) {
			dv.header(3, "🎯 График максимальных повторений в подходе");
			const chartData = Array.from(maxReps.entries()).sort((a, b) => (a[0] < b[0] ? -1 : 1));
			const labels = chartData.map(([date]) => {
				const parts = date.split('-');
				return parts[2] + "." + parts[1];
			});
			const values = chartData.map(([, reps]) => reps);
			const mermaidChart = "```mermaid\n%%{init: {'theme':'base', 'themeVariables': { 'xyChart': {'plotColorPalette': '#FF6B00'}}}}%%\nxychart-beta\n    title \"Максимальные повторения в подходе за день\"\n    x-axis [" + labels.map(l => '"' + l + '"').join(', ') + "]\n    y-axis \"Повторения\" 0 --> " + (Math.max(...values) + 5) + "\n    line [" + values.join(', ') + "]\n```";
			dv.paragraph(mermaidChart);
			dv.paragraph("");
		}

		if (summaryRows.length > 0) {
			dv.paragraph("");
			dv.header(3, "📊 Суммарные повторения по дням");
			dv.table(["Дата", "Повторения"], summaryRows);
		}

		if (maxRepsRows.length > 0) {
			dv.paragraph("");
			dv.header(3, "🏆 Максимальные повторения по дням");
			dv.table(["Дата", "Повторения"], maxRepsRows);
		}

		dv.paragraph("");
		dv.header(3, "📋 Детальная статистика");
		dv.table(["Дата", "Подход", "Повторения", "Описание"], rows);
	}
}
